---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site.config';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length ? featured : projects).slice(0, 4);
const links = [
  site.links.github && { label: 'GitHub', href: site.links.github },
  site.links.scholar && { label: 'Google Scholar', href: site.links.scholar },
  site.links.cv && { label: 'CV', href: site.links.cv },
  site.links.email && { label: 'Email', href: `mailto:${site.links.email}` },
].filter(Boolean) as { label: string; href: string }[];
---

<Base>
  <section class="container hero">
    <p class="eyebrow">{site.title} · {site.affiliation}</p>
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <div class="bio">{site.bio.map((p) => <p>{p}</p>)}</div>
    <div class="links">{links.map((l) => <a class="pill" href={l.href}>{l.label}</a>)}</div>
  </section>

  <section class="container">
    <div class="section-head">
      <h2>{featured.length ? 'Selected projects' : 'Recent projects'}</h2>
      <a href="/projects/">All projects →</a>
    </div>
    <div class="grid">{shown.map((p) => <ProjectCard project={p} />)}</div>
  </section>
</Base>

<style>
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.03em;
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--ink-2);
    max-width: 38rem;
    margin: 0 0 1.75rem;
  }
  .bio {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: var(--measure);
  }
  .bio p {
    margin: 0 0 1rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .pill {
    font-size: 0.875rem;
    text-decoration: none;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    background: var(--surface);
  }
  .pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
    margin-bottom: 1.25rem;
  }
  .section-head h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .section-head a {
    font-size: 0.9rem;
    text-decoration: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
  }
</style>
