---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, slugOf, formatDate, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: slugOf(project) }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const { Content, headings } = await render(project);
const { title, summary, date, tags, links } = project.data;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description={summary}>
  <article class="container">
    <header>
      <a href="/projects/" class="back">← Projects</a>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <div class="meta">
        <span>{formatDate(date)}</span>
        {tags.map((t) => <span class="chip">{t}</span>)}
      </div>
      {
        links.length > 0 && (
          <div class="links">
            {links.map((l) => <a href={l.href}>{l.label} ↗</a>)}
          </div>
        )
      }
    </header>

    <div class="layout">
      {
        toc.length > 2 && (
          <nav class="toc" aria-label="Contents">
            <p class="eyebrow">Contents</p>
            <ol>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<script>
  // Highlight the TOC entry for the section currently in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [
      decodeURIComponent(a.hash.slice(1)),
      a,
    ]),
  );
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('current'));
        links.get(e.target.id)?.classList.add('current');
      }
    },
    { rootMargin: '-15% 0px -75% 0px' },
  );
  document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((h) => obs.observe(h));
</script>

<style>
  header {
    padding: 3rem 0 2rem;
    max-width: var(--measure);
  }
  .back {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink-3);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.025em;
    margin: 1rem 0 0.75rem;
  }
  .summary {
    font-size: 1.2rem;
    color: var(--ink-2);
    margin: 0 0 1.25rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .meta > span:first-child {
    margin-right: 0.5rem;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  .layout {
    position: relative;
  }
  .toc {
    display: none;
  }
  @media (min-width: 1460px) {
    .toc {
      display: block;
      position: absolute;
      left: calc(100% + 1rem);
      top: 0;
      height: 100%;
      width: 13rem;
    }
    .toc ol {
      position: sticky;
      top: 5rem;
    }
  }
  .toc .eyebrow {
    margin: 0 0 0.5rem;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .toc li {
    margin: 0.4rem 0;
  }
  .toc li.d3 {
    padding-left: 0.85rem;
  }
  .toc a {
    color: var(--ink-3);
    text-decoration: none;
  }
  .toc a:hover,
  .toc a.current {
    color: var(--ink);
  }
</style>
